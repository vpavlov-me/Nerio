{
  "name": "@nerio-ui/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --workspace-root build:public-packages",
    "dev": "next dev --port 3000",
    "prebuild": "pnpm --workspace-root build:public-packages",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare:foundation-metadata": "node scripts/validate-foundation-metadata.mjs --write",
    "validate:foundation-metadata": "node scripts/validate-foundation-metadata.mjs",
    "test:foundation-metadata": "node --test scripts/foundation-metadata.test.mjs",
    "validate:docs": "node scripts/validate-foundation-metadata.mjs && node scripts/validate-docs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@nerio-ui/adapters": "workspace:*",
    "@nerio-ui/registry": "workspace:*",
    "@nerio-ui/tokens": "workspace:*",
    "@nerio-ui/ui": "workspace:*",
    "motion": "12.43.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "5.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nerio-ui/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
