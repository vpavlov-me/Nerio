{
  "packageInstall": [
    "pnpm add @nerio-ui/tokens@1.0.0-beta.0 @nerio-ui/adapters@1.0.0-beta.0 @nerio-ui/ui@1.0.0-beta.0 tailwindcss",
    "pnpm add -D @tailwindcss/postcss postcss"
  ],
  "cli": {
    "localInstall": "pnpm add -D @nerio-ui/registry@1.0.0-beta.0 @nerio-ui/cli@1.0.0-beta.0",
    "localCommands": [
      "pnpm exec nerio init",
      "pnpm exec nerio list",
      "pnpm exec nerio info button",
      "pnpm exec nerio add button --dry-run",
      "pnpm exec nerio add button",
      "pnpm exec nerio diff button",
      "pnpm exec nerio update button --dry-run",
      "pnpm exec nerio doctor"
    ],
    "oneOffCommands": [
      "pnpm dlx @nerio-ui/cli@1.0.0-beta.0 init",
      "pnpm dlx @nerio-ui/cli@1.0.0-beta.0 add button"
    ]
  },
  "mcp": {
    "localInstall": "pnpm add -D @nerio-ui/mcp@1.0.0-beta.0",
    "localConfiguration": {
      "command": "pnpm",
      "args": ["exec", "nerio-mcp"]
    },
    "oneOffConfiguration": {
      "command": "pnpm",
      "args": ["dlx", "@nerio-ui/mcp@1.0.0-beta.0"]
    }
  }
}
