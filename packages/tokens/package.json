{
  "name": "@nerio-ui/tokens",
  "version": "1.0.0-beta.1",
  "description": "Nerio Core design tokens, themes, modes, density, and CSS variable contracts.",
  "keywords": [
    "nerio",
    "design-system",
    "design-tokens",
    "css-variables",
    "tailwindcss"
  ],
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vpavlov-me/Nerio.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://nerio.vpavlov.com/docs/foundations/tokens",
  "bugs": {
    "url": "https://github.com/vpavlov-me/Nerio/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "./dist/tailwind.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-package-output.mjs tokens",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nerio-ui/config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^7.0.2"
  }
}
