{
  "name": "@nerio-ui/adapters",
  "version": "1.0.0-beta.1",
  "description": "Responsibility-scoped Nerio Core adapters for icons, tables, charts, forms, schemas, and optional advanced motion.",
  "keywords": [
    "nerio",
    "design-system",
    "react",
    "adapters",
    "lucide",
    "motion"
  ],
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vpavlov-me/Nerio.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://nerio.vpavlov.com/docs/foundations/icons",
  "bugs": {
    "url": "https://github.com/vpavlov-me/Nerio/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "exports": {
    "./icons": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./table": {
      "types": "./src/table.ts",
      "default": "./src/table.ts"
    },
    "./charts": {
      "types": "./src/charts.ts",
      "default": "./src/charts.ts"
    },
    "./forms": {
      "types": "./src/forms.ts",
      "default": "./src/forms.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./motion": {
      "types": "./src/motion.tsx",
      "default": "./src/motion.tsx"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test:motion": "tsc --project tsconfig.test.json && vitest run test/motion.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "@nerio-ui/config": "workspace:*",
    "@tanstack/react-table": "^9.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.2",
    "jsdom": "30.0.1",
    "motion": "12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.1.2",
    "motion": "^12.42.2",
    "react": ">=19 <20",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.6.0",
    "zod": "^4.2.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
